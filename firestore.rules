rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador do painel: só este e-mail, entrando com a conta Google dele (com verificação em duas etapas ligada no Google).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['clouts.oficial2026@gmail.com'];
    }

    // Formato aceito para uma peça (bloqueia campos extras, textos gigantes e valores inválidos).
    function produtoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','cod','nome','secao','modelo','preco','cor','tecido','lycra','tam',
                               'visivel','esgotado','premium','diamond','img','extras','ordem','maisVendido','rankMV','ref','descricao','precoAntigo','nFotos','tipoTam','estoque','custo'])
        && d.get('custo', 0) is number && d.get('custo', 0) >= 0 && d.get('custo', 0) <= 100000
        && d.get('estoque', {}) is map
        && d.get('tipoTam', 'numero') in ['numero', 'letra']
        && d.get('nFotos', 0) is number && d.get('nFotos', 0) >= 0 && d.get('nFotos', 0) <= 9
        && d.get('precoAntigo', 0) is number && d.get('precoAntigo', 0) >= 0 && d.get('precoAntigo', 0) <= 100000
        && d.get('ref', '') is string && d.get('ref', '').size() <= 60
        && d.get('descricao', '') is string && d.get('descricao', '').size() <= 600
        && d.cod is string && d.cod.size() > 0 && d.cod.size() <= 40
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 140
        && d.secao in ['feminino', 'masculino']
        && d.get('modelo', '') is string && d.get('modelo', '').size() <= 60
        && d.preco is number && d.preco >= 0 && d.preco <= 100000
        && d.tam is list && d.tam.size() <= 20
        && d.img is string && d.img.size() > 0 && d.img.size() < 950000
        && (!('extras' in d) || (d.extras is list && d.extras.size() <= 9));
    }

    // Catálogo: qualquer visitante lê; só o administrador cria, altera ou exclui.
    match /produtos/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && produtoValido();
      allow delete: if isAdmin();
    }

    // Fotos extras da peça (galeria de até 10 fotos: a principal fica na peça, as outras aqui). Leitura pública; só o administrador grava.
    match /produtos/{id}/fotos/{fid} {
      allow read: if true;
      allow create, update: if isAdmin() && fid.matches('^[1-9]$')
        && request.resource.data.keys().hasOnly(['img', 'ordem'])
        && request.resource.data.img is string && request.resource.data.img.size() > 0 && request.resource.data.img.size() < 950000
        && request.resource.data.ordem is number;
      allow delete: if isAdmin();
    }

    // Configurações da loja editáveis no painel (liga/desliga cupons, frase da barra, WhatsApp). Leitura pública; só o administrador grava.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'loja'
        && request.resource.data.keys().hasOnly(['cupomAmigo', 'cupomBemvindo', 'cupomPrimeira', 'primeiraPct', 'primeiraDias', 'campanhas', 'popupConvite', 'barra', 'whatsapp', 'gaId', 'pixelId', 'cloudName', 'uploadPreset', 'guiaMedidas'])
        && request.resource.data.get('gaId', '') is string && request.resource.data.get('gaId', '').matches('^(G-[A-Z0-9]{4,15})?$')
        && request.resource.data.get('pixelId', '') is string && request.resource.data.get('pixelId', '').matches('^[0-9]{0,20}$')
        && request.resource.data.get('cloudName', '') is string && request.resource.data.get('cloudName', '').matches('^[A-Za-z0-9_-]{0,60}$')
        && request.resource.data.get('uploadPreset', '') is string && request.resource.data.get('uploadPreset', '').matches('^[A-Za-z0-9_-]{0,60}$')
        && request.resource.data.get('guiaMedidas', '') is string && request.resource.data.get('guiaMedidas', '').size() <= 3000
        && request.resource.data.get('cupomPrimeira', true) is bool
        && request.resource.data.get('primeiraPct', 10) is number && request.resource.data.get('primeiraPct', 10) >= 1 && request.resource.data.get('primeiraPct', 10) <= 50
        && request.resource.data.get('primeiraDias', 7) is number && request.resource.data.get('primeiraDias', 7) >= 1 && request.resource.data.get('primeiraDias', 7) <= 30
        && request.resource.data.get('cupomAmigo', true) is bool && request.resource.data.get('cupomBemvindo', true) is bool
        && request.resource.data.get('campanhas', true) is bool && request.resource.data.get('popupConvite', true) is bool
        && request.resource.data.get('barra', '') is string && request.resource.data.get('barra', '').size() <= 140
        && request.resource.data.get('whatsapp', '') is string && request.resource.data.get('whatsapp', '').matches('^[0-9]{0,15}$');
    }
    function cfgLigado(k) {
      return !exists(/databases/$(database)/documents/config/loja)
        || get(/databases/$(database)/documents/config/loja).data.get(k, true) != false;
    }

    // Códigos promocionais criados pelo dono (campanhas/{CÓDIGO}). O cliente consulta um código que conhece (get); só o administrador lista e edita.
    match /campanhas/{codigo} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && codigo.matches('^[A-Z0-9]{3,20}$')
        && request.resource.data.keys().hasOnly(['percent', 'ativo', 'expiraEm', 'descricao', 'criadoEm'])
        && request.resource.data.percent is number && request.resource.data.percent >= 1 && request.resource.data.percent <= 90
        && request.resource.data.ativo is bool
        && request.resource.data.get('descricao', '') is string && request.resource.data.get('descricao', '').size() <= 120
        && (request.resource.data.get('expiraEm', null) == null || request.resource.data.expiraEm is timestamp);
      allow delete: if isAdmin();
    }

    // Formato aceito para um aviso/promoção (o link só pode levar para páginas da própria loja).
    function avisoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titulo','mensagem','tipo','link','criadoEm','expiraEm'])
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 80
        && d.mensagem is string && d.mensagem.size() > 0 && d.mensagem.size() <= 400
        && d.tipo in ['promocao', 'aviso']
        && d.get('link', '') in ['', '#/feminino', '#/masculino', '#/mais-vendidos', '#/cupons', '#/entrega']
        && d.criadoEm == request.time
        && (d.get('expiraEm', null) == null || d.expiraEm is timestamp);
    }

    // Avisos e promoções (sininho da loja): qualquer visitante lê; só o administrador envia ou remove.
    match /avisos/{id} {
      allow read: if true;
      allow create: if isAdmin() && avisoValido();
      allow delete: if isAdmin();
    }

    // Degrau do desconto conforme os amigos que entraram pelo link do cliente: 1 = 5%, 5 = 10%, 10 = 20%.
    function nConvites(uid) {
      return get(/databases/$(database)/documents/referrals/$(uid)).data.n;
    }
    function degrau(n) {
      return n >= 10 ? 20 : (n >= 5 ? 10 : 5);
    }

    // Cupom único de cada cliente: users/{uid}/cupons/AMIGO
    match /users/{uid}/cupons/{cid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Criado uma única vez, com o degrau atual, e só depois de pelo menos 1 amigo.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codigo', 'percent', 'usado', 'origem', 'criadoEm'])
        && request.resource.data.usado == false
        && request.resource.data.criadoEm == request.time
        && (
          // Cupom de quem convida (AMIGO): 5/10/20% conforme os amigos.
          (cid == 'AMIGO' && cfgLigado('cupomAmigo')
            && exists(/databases/$(database)/documents/referrals/$(uid))
            && nConvites(uid) >= 1
            && request.resource.data.codigo == 'AMIGO'
            && request.resource.data.percent == degrau(nConvites(uid))
            && request.resource.data.origem == 'indicacao')
          ||
          // Cupom de quem foi convidado e usou o código de um amigo (BEMVINDO): 10% na primeira compra, uma vez.
          (cid == 'BEMVINDO' && cfgLigado('cupomBemvindo')
            && exists(/databases/$(database)/documents/users/$(uid)/meta/indicacao)
            && request.resource.data.codigo == 'BEMVINDO'
            && request.resource.data.percent == 10
            && request.resource.data.origem == 'codigo')
        );

      // Enquanto não usado: pode subir para o degrau que os convites justificam ou ser marcado como usado. Nunca volta.
      allow update: if request.auth != null && request.auth.uid == uid
        && resource.data.usado == false
        && (
          (request.resource.data.usado == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado']))
          ||
          (cid == 'AMIGO'
            && request.resource.data.usado == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['percent'])
            && request.resource.data.percent == degrau(nConvites(uid))
            && request.resource.data.percent > resource.data.percent)
        );

      allow delete: if false;
    }

    // Códigos de convite: codigos/{CÓDIGO} -> dono. Qualquer cliente logado consulta um código que conhece (get), ninguém lista todos.
    match /codigos/{codigo} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && codigo.matches('^[A-Z0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/meta/codigo)
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/meta/codigo);
      allow update, delete: if false;
    }

    // Dados do cliente: meta/codigo (o código dele, criado uma vez) e meta/indicacao (quem o convidou, registrado uma vez, sem alterar).
    match /users/{uid}/meta/{doc} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid && (
        (doc == 'codigo'
          && request.resource.data.keys().hasOnly(['codigo'])
          && existsAfter(/databases/$(database)/documents/codigos/$(request.resource.data.codigo))
          && getAfter(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.uid == uid)
        ||
        (doc == 'indicacao'
          && request.resource.data.keys().hasOnly(['ref', 'codigo', 'criadoEm'])
          && request.resource.data.ref != uid
          && request.resource.data.criadoEm == request.time
          && exists(/databases/$(database)/documents/codigos/$(request.resource.data.codigo))
          && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.uid == request.resource.data.ref)
      );
      allow update, delete: if false;
    }

    // Convites: referrals/{quemConvidou} guarda o contador n; convidados/{amigo} garante 1 contagem por conta.
    match /referrals/{refUid} {
      allow read: if request.auth != null && (request.auth.uid == refUid || isAdmin());

      // O amigo (outra conta) soma exatamente 1, e só se o registro dele for criado na mesma operação.
      allow create: if request.auth != null && request.auth.uid != refUid
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1
        && !exists(/databases/$(database)/documents/referrals/$(refUid)/convidados/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/referrals/$(refUid)/convidados/$(request.auth.uid));
      allow update: if request.auth != null && request.auth.uid != refUid
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1
        && !exists(/databases/$(database)/documents/referrals/$(refUid)/convidados/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/referrals/$(refUid)/convidados/$(request.auth.uid));

      match /convidados/{amigo} {
        allow read: if isAdmin();
        allow create: if request.auth != null && request.auth.uid == amigo && amigo != refUid
          && request.resource.data.keys().hasOnly(['criadoEm'])
          && request.resource.data.criadoEm == request.time
          && existsAfter(/databases/$(database)/documents/referrals/$(refUid));
      }
    }

    // Pedidos pagos online: criados e atualizados só pelo servidor (api/checkout e api/webhook). O cliente lê os próprios; o administrador lê todos.
    match /pedidos/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      // Pedido feito pelo WhatsApp: o cliente logado registra o pedido (fica "aguardando"); o administrador confirma a venda no painel.
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'cliente', 'itens', 'subtotal', 'desconto', 'frete', 'total', 'cupom', 'percent', 'cidade', 'origem', 'status', 'criadoEm'])
        && request.resource.data.origem == 'whatsapp' && request.resource.data.status == 'aguardando'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.itens is list && request.resource.data.itens.size() > 0 && request.resource.data.itens.size() <= 40
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total < 100000
        && request.resource.data.cliente is map;
      allow delete: if false;
      // O administrador muda o andamento da entrega e, nos pedidos do WhatsApp, confirma ou cancela a venda (nos pagos online só o servidor mexe no pagamento).
      allow update: if isAdmin() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['andamento'])
          && request.resource.data.andamento in ['novo', 'preparando', 'enviado', 'entregue'])
        ||
        (resource.data.get('origem', '') == 'whatsapp' && resource.data.status == 'aguardando'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'andamento'])
          && request.resource.data.status in ['pago', 'cancelado']
          && request.resource.data.get('andamento', 'novo') in ['novo', 'preparando', 'enviado', 'entregue'])
      );
    }

    // Todo o resto fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
