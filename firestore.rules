rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador do painel: só este e-mail, entrando com e-mail e senha.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in ['clouts.oficial2026@gmail.com'];
    }

    // Formato aceito para uma peça (bloqueia campos extras, textos gigantes e valores inválidos).
    function produtoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','cod','nome','secao','modelo','preco','cor','tecido','lycra','tam',
                               'visivel','esgotado','premium','diamond','img','extras','ordem','maisVendido','rankMV'])
        && d.cod is string && d.cod.size() > 0 && d.cod.size() <= 40
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 140
        && d.secao in ['feminino', 'masculino']
        && d.get('modelo', '') is string && d.get('modelo', '').size() <= 60
        && d.preco is number && d.preco >= 0 && d.preco <= 100000
        && d.tam is list && d.tam.size() <= 12
        && d.img is string && d.img.size() > 0 && d.img.size() < 950000
        && (!('extras' in d) || (d.extras is list && d.extras.size() <= 6));
    }

    // Catálogo: qualquer visitante lê; só o administrador cria, altera ou exclui.
    match /produtos/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && produtoValido();
      allow delete: if isAdmin();
    }

    // Degrau do desconto conforme os amigos que entraram pelo link do cliente: 1 = 5%, 5 = 10%, 10 = 20%.
    function nConvites(uid) {
      return get(/databases/$(database)/documents/referrals/$(uid)).data.n;
    }
    function degrau(n) {
      return n >= 10 ? 20 : (n >= 5 ? 10 : 5);
    }

    // Cupom único de cada cliente: users/{uid}/cupons/AMIGO
    match /users/{uid}/cupons/{cid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Criado uma única vez, com o degrau atual, e só depois de pelo menos 1 amigo.
      allow create: if request.auth != null && request.auth.uid == uid
        && cid == 'AMIGO'
        && exists(/databases/$(database)/documents/referrals/$(uid))
        && nConvites(uid) >= 1
        && request.resource.data.keys().hasOnly(['codigo', 'percent', 'usado', 'origem', 'criadoEm'])
        && request.resource.data.codigo == 'AMIGO'
        && request.resource.data.percent == degrau(nConvites(uid))
        && request.resource.data.usado == false
        && request.resource.data.origem == 'indicacao'
        && request.resource.data.criadoEm == request.time;

      // Enquanto não usado: pode subir para o degrau que os convites justificam ou ser marcado como usado. Nunca volta.
      allow update: if request.auth != null && request.auth.uid == uid
        && resource.data.usado == false
        && (
          (request.resource.data.usado == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado']))
          ||
          (request.resource.data.usado == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['percent'])
            && request.resource.data.percent == degrau(nConvites(uid))
            && request.resource.data.percent > resource.data.percent)
        );

      allow delete: if false;
    }

    // Convites: referrals/{quemConvidou} guarda o contador n; convidados/{amigo} garante 1 contagem por conta.
    match /referrals/{refUid} {
      allow read: if request.auth != null && (request.auth.uid == refUid || isAdmin());

      // O amigo (outra conta) soma exatamente 1, e só se o registro dele for criado na mesma operação.
      allow create: if request.auth != null && request.auth.uid != refUid
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1
        && !exists(/databases/$(database)/documents/referrals/$(refUid)/convidados/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/referrals/$(refUid)/convidados/$(request.auth.uid));
      allow update: if request.auth != null && request.auth.uid != refUid
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1
        && !exists(/databases/$(database)/documents/referrals/$(refUid)/convidados/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/referrals/$(refUid)/convidados/$(request.auth.uid));

      match /convidados/{amigo} {
        allow read: if isAdmin();
        allow create: if request.auth != null && request.auth.uid == amigo && amigo != refUid
          && request.resource.data.keys().hasOnly(['criadoEm'])
          && request.resource.data.criadoEm == request.time
          && existsAfter(/databases/$(database)/documents/referrals/$(refUid));
      }
    }

    // Todo o resto fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
